  dialogueLines:
  - speakerName: "\u795E\u79D8\u5546\u4EBA"
    content: "\u4F60\u662F\u90A3\u4F4D\u76D7\u8D3C\u7684\u670B\u53CB\u5417\uFF0C\u6211\u548C\u6211\u5144\u5F1F\u4E0E\u76D7\u8D3C\u5408\u4F5C\u591A\u5E74\u4E86\uFF0C\u7EDD\u5BF9\u662F\u53EF\u4EE5\u4FE1\u4EFB\u7684\u4EBA"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u795E\u79D8\u5546\u4EBA"
    content: "\u65C1\u8FB9\u95E8\u7684\u94A5\u5319\u6211\u5C31\u653E\u5728\u95E8\u8FB9\u4E0A\uFF0C\u4F60\u76F4\u63A5\u62FF\u53BB\u7528\u5427"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u795E\u79D8\u5546\u4EBA"
    content: "\u4F46\u6211\u6709\u4E00\u4E2A\u8BF7\u6C42\uFF0C\u6211\u7684\u597D\u5144\u5F1F\u4E4B\u524D\u88AB\u536B\u5175\u6293\u8D70\u4E86\uFF0C\u73B0\u5728\u5173\u57283\u5C42\u7684\u7262\u623F\uFF0C\u8FD9\u4E9B\u536B\u5175\u771F\u4E0D\u8BB2\u9053\u7406\uFF0C\u5C45\u7136\u56E0\u4E3A\u4EF7\u683C\u4E0D\u5408\u7406\u5C31\u628A\u4ED6\u6293\u8D70\uFF0C\u4E00\u5206\u94B1\u4E00\u5206\u8D27\u7684\u9053\u7406\u90FD\u4E0D\u61C2\u5417"
    showChoices: 0
    nextLineIndex: -2
  - speakerName: "\u795E\u79D8\u5546\u4EBA"
    content: "\u8C22\u8C22\u4F60\u6551\u4E86\u4ED6\uFF0C\u6211\u4EEC\u4E24\u5144\u5F1F\u7EC8\u4E8E\u53C8\u80FD\u56E2\u805A\u4E86"
    showChoices: 0
    nextLineIndex: -1
