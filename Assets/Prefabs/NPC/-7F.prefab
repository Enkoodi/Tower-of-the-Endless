  - speakerName: "\u5C0F\u5077"
    content: "\u89C1\u9762\u6B21\u6570\u592A\u591A\u4E86\u5417..."
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u4F46\u8FD9\u5E94\u8BE5\u662F\u6700\u540E\u4E00\u6B21\u4E86"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u80FD\u6765\u5230\u8FD9\u91CC\uFF0C\u4F60\u4E00\u5B9A\u4ED8\u51FA\u4E86\u4E0D\u5C11\u52AA\u529B\u5427"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u60F3\u5FC5\u8FD9\u5EA7\u5854\u5BF9\u4F60\u800C\u8A00\u5DF2\u65E0\u79D8\u5BC6"
    showChoices: 1
    nextLineIndex: -2
  - speakerName: "\u5C0F\u5077"
    content: "\u5C45\u7136\u8FD8\u6709\u5417\uFF1F"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u4E3A\u4EC0\u4E48\u8981\u865A\u6784<b>\u516C\u4E3B</b>\uFF1F"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u8FD9\u6837\u624D\u80FD\u5438\u5F15\u771F\u6B63\u7684\u5F3A\u8005\u6765\u561B\uFF0C\u800C\u4E14<b>\u516C\u4E3B</b>\u662F\u771F\u5B9E\u5B58\u5728\u7684\u54E6"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u5854\u5B58\u5728\u7684\u610F\u4E49\u662F\u4EC0\u4E48\u5417"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u4F5C\u4E3A\u6311\u6218\u8005\u7684\u4F60\u4EEC\u5C31\u662F\u8FD9\u5EA7\u5854\u5B58\u5728\u7684\u610F\u4E49"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u6211\u7A76\u7ADF\u662F\u8C01\uFF1F"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u561B......\u8FD9\u4E2A\u662F\u4E0D\u80FD\u8BF4\u7684\u79D8\u5BC6\u54E6"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "\u90A3\u4E48\u518D\u89C1\u4E86\u2014\u2014"
    showChoices: 0
    nextLineIndex: -1
  - speakerName: "\u5C0F\u5077"
    content: "<b>\u6211\u7684\u52C7\u8005\u5927\u4EBA</b>"
    showChoices: 0
    nextLineIndex: -1
