  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: "\u8001\u8005"
    content: "\u5927\u9B54\u5BFC\u5E08\u662F\u8FD9\u5EA7\u9B54\u5854\u7684\u4E3B\u4EBA\uFF0C\u4ED6\u4E5F\u638C\u7BA1\u7740\u8FD9\u7247\u533A\u57DF"
    showChoices: 0
  - speakerName: "\u8001\u8005"
    content: "\u800C\u8FD9\u7247\u533A\u57DF\u66FE\u53D1\u751F\u8FC7\u4E00\u6B21\u5DE8\u5927\u7684\u9B54\u529B\u707E\u5BB3\uFF0C\u4F46\u4ED6\u5374\u7F6E\u4E4B\u4E0D\u7406\uFF0C\u53EF\u80FD\u707E\u5BB3\u672C\u8EAB\u5C31\u662F\u4ED6\u5F15\u8D77\u7684\uFF0C\u8FD9\u6B63\u662F\u4ED6\u610F\u56FE"
    showChoices: 0
  - speakerName: "\u8001\u8005"
    content: "\u9B54\u529B\u707E\u5BB3\u4E4B\u540E\u5404\u5BB6\u5404\u6237\u7684\u5B9D\u7269\u6563\u843D\u5730\u5230\u5904\u90FD\u662F\uFF0C\u6709\u53EA\u53F2\u83B1\u59C6\u4E58\u673A\u541E\u4E0B\u4E86\u8BB8\u591A\u5B9D\u7269\uFF0C\u53D8\u5F97\u975E\u5E38\u5F3A\u5927\uFF0C\u5176\u4ED6\u4EBA\u5BF9\u5B83\u975E\u5E38\u4E0D\u6EE1\uFF0C\u4F46\u4E5F\u675F\u624B\u65E0\u7B56"
    showChoices: 0
  choice1Text: "\u9009\u98791"
  choice2Text: "\u9009\u98792"
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
